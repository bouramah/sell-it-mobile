# Copie ce fichier en .env et remplace par l'IP LAN de ta machine de dev
# (localhost ne fonctionne pas depuis un téléphone/simulateur).
# Trouver son IP : `ipconfig getifaddr en0` (Mac) ou `ipconfig` (Windows).
# Le backend doit tourner avec --host 0.0.0.0 pour être joignable depuis le réseau.
EXPO_PUBLIC_API_BASE=http://192.168.1.100:8000/api/v1
