# Pointe vers le backend de prod par défaut. Pour développer contre un backend local,
# remplace par l'IP LAN de ta machine (localhost ne fonctionne pas depuis un téléphone/
# simulateur) : `ipconfig getifaddr en0` (Mac) ou `ipconfig` (Windows). Le backend local doit
# tourner avec --host 0.0.0.0 pour être joignable depuis le réseau.
EXPO_PUBLIC_API_BASE=https://admin.kfstore-gn.com/api/v1
# EXPO_PUBLIC_API_BASE=http://192.168.1.100:8000/api/v1
